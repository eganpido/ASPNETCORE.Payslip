@model PayslipMvcClient.Models.PayslipViewModel
@{
    ViewData["Title"] = "Payslip Viewer";
}

<style>
    :root {
        --surface-bg: #f8fafc;
        --border-subtle: #e2e8f0;
        --text-main: #0f172a;
        --text-muted-custom: #64748b;
    }

    html {
        -webkit-text-size-adjust: 100%;
    }

    .payslip-page {
        max-width: 960px;
        width: 100%;
    }

    .hero-card {
        border: 0;
        border-radius: 1rem;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0f766e 100%);
        color: #fff;
    }

    .lookup-card,
    .payslip-card {
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 1rem;
        background-color: #fff;
    }

    .net-pay-banner {
        background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
        border: 1px solid #a7f3d0;
        border-radius: 0.875rem;
    }

    .stat-tile {
        background-color: var(--surface-bg);
        border: 1px solid var(--border-subtle);
        border-radius: 0.75rem;
        padding: 0.75rem 0.85rem;
        height: 100%;
        min-width: 0;
    }

    .stat-label {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted-custom);
        margin-bottom: 0.25rem;
        line-height: 1.25;
    }

    .stat-value {
        font-size: clamp(0.92rem, 2.2vw, 1.05rem);
        font-weight: 700;
        color: var(--text-main);
        font-variant-numeric: tabular-nums;
        overflow-wrap: anywhere;
        line-height: 1.3;
    }

    .net-pay-amount {
        font-size: clamp(1.45rem, 4.5vw, 2rem);
        font-variant-numeric: tabular-nums;
        line-height: 1.15;
    }

    .breakdown-box {
        background-color: var(--surface-bg);
        border: 1px solid var(--border-subtle);
        border-radius: 0.75rem;
        padding: 0.75rem 0.85rem;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .breakdown-box table {
            width: 100% !important;
            min-width: 240px;
            border-collapse: collapse;
            margin-bottom: 0;
        }

        .breakdown-box td {
            width: auto !important;
            font-size: 0.84rem !important;
            padding: 0.4rem 0.3rem;
            border-bottom: 1px dashed var(--border-subtle);
            vertical-align: top;
        }

            .breakdown-box td:last-child {
                text-align: right !important;
                font-variant-numeric: tabular-nums;
                white-space: nowrap;
                padding-left: 0.75rem;
            }

        .breakdown-box tr:last-child td {
            border-bottom: 0;
        }

    /* Phones & small screens */
    @@media (max-width: 575.98px) {
        .payslip-page {
            padding-left: 0.35rem;
            padding-right: 0.35rem;
        }

        .hero-card .card-body,
        .lookup-card .card-body,
        .payslip-card .card-header,
        .payslip-card .card-body {
            padding: 0.9rem !important;
        }

        .form-control,
        .form-select,
        .btn {
            min-height: 46px;
            font-size: 16px; /* Prevents iOS Safari auto-zoom on focus */
        }

        .stat-tile {
            padding: 0.65rem 0.7rem;
        }

        .card-actions {
            width: 100%;
            justify-content: space-between;
        }
    }

    /* Extra small phones (e.g., 320px - 360px) */
    @@media (max-width: 359.98px) {
        .stat-tile {
            padding: 0.55rem 0.6rem;
        }

        .stat-label {
            font-size: 0.64rem;
        }

        .stat-value {
            font-size: 0.86rem;
        }
    }

    /* Landscape phones */
    @@media (max-height: 480px) and (orientation: landscape) {
        .payslip-page {
            padding-top: 0.5rem !important;
            padding-bottom: 0.75rem !important;
        }
    }

    @@media print {
        body {
            background: #fff !important;
        }

        .no-print {
            display: none !important;
        }

        .payslip-card {
            box-shadow: none !important;
            border: 1px solid #cbd5e1 !important;
        }

        .breakdown-box {
            overflow: visible !important;
        }
    }
</style>

<div class="container payslip-page py-3 py-md-4">
    <!-- Header Banner -->
    <div class="card hero-card shadow-sm mb-3 mb-md-4 no-print">
        <div class="card-body p-3 p-md-4 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
            <div class="min-w-0">
                <span class="badge bg-light text-dark mb-1">WHRIS Mobile</span>
                <h1 class="h4 h3-md mb-1 fw-bold">Payslip Viewer</h1>
                <p class="mb-0 small text-white-50">Select a Payroll Number to view your payslip details.</p>
            </div>
            <div class="flex-shrink-0">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3">
                    Switch Code
                </a>
            </div>
        </div>
    </div>

    <!-- Payroll Number Dropdown Form -->
    <div class="card lookup-card shadow-sm mb-3 mb-md-4 no-print">
        <div class="card-body p-3 p-md-4">
            <form id="payslipForm" asp-action="Index" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Code" />

                <div class="col-12 col-md-8">
                    <label asp-for="SelectedPayrollId" class="form-label fw-semibold small text-uppercase text-muted"></label>
                    <select asp-for="SelectedPayrollId"
                            asp-items="Model.PayrollOptions"
                            onchange="submitPayslipForm()"
                            class="form-select">
                    </select>
                </div>

                <div class="col-12 col-md-4 d-grid">
                    <button id="fetchPayslipBtn" type="submit" class="btn btn-primary fw-semibold">
                        Fetch Payslip
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Error / Info Alert -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning rounded-3 shadow-sm d-flex align-items-start gap-2 no-print" role="alert">
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <!-- Payslip Results -->
    @foreach (var item in Model.Records)
    {
        <div class="card payslip-card shadow-sm mb-4">
            <!-- Employee & Payroll Header -->
            <div class="card-header bg-white border-bottom p-3 p-md-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                    <div class="min-w-0">
                        <div class="text-muted small fw-medium">@item.Company</div>
                        <h2 class="h5 mb-1 fw-bold text-dark">@item.FullName</h2>
                        <div class="d-flex flex-wrap gap-2 small text-secondary">
                            <span><strong>Payroll #:</strong> @(item.PayrollNumber ?? "N/A")</span>
                            <span class="d-none d-sm-inline">•</span>
                            <span><strong>Date:</strong> @(item.PayrollDate?.ToString("MMM dd, yyyy") ?? "N/A")</span>
                            <span class="d-none d-sm-inline">•</span>
                            <span><strong>Hours:</strong> @item.TotalWorkingHours.ToString("N2") hrs</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 card-actions flex-shrink-0 no-print">
                        <span class="badge @(item.IsLocked ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border") px-3 py-2 rounded-pill">
                            @(item.IsLocked ? "Approved / Final" : "Draft")
                        </span>
                       @*  <button type="button" onclick="window.print()" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            Print
                        </button> *@
                    </div>
                </div>
            </div>

            <div class="card-body p-3 p-md-4">
                <!-- Net Pay Highlight -->
                <div class="net-pay-banner p-3 p-md-4 mb-4 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                    <div class="min-w-0">
                        <div class="small fw-semibold text-success text-uppercase">Net Pay</div>
                        <div class="small text-muted">Payroll #: @(item.PayrollNumber ?? item.PayrollId.ToString()) | Mobile Code: @Model.Code</div>
                    </div>
                    <div class="net-pay-amount fw-bold text-success">
                        @item.NetIncome.ToString("N2")
                    </div>
                </div>

                <!-- Earnings Summary -->
                <h3 class="h6 fw-bold text-uppercase text-muted mb-2">Earnings</h3>
                <div class="row g-2 g-md-3 mb-4">
                    <div class="col-6 col-md-4">
                        <div class="stat-tile">
                            <div class="stat-label">Basic Salary</div>
                            <div class="stat-value">@item.BasicSalary.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="stat-tile">
                            <div class="stat-label">Other Salary / OT</div>
                            <div class="stat-value">@item.OtherSalary.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="stat-tile">
                            <div class="stat-label">Gross Income</div>
                            <div class="stat-value">@item.GrossIncome.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="stat-tile">
                            <div class="stat-label">Non-Taxable Income</div>
                            <div class="stat-value">@item.TotalOtherIncomeNonTaxable.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="stat-tile">
                            <div class="stat-label">Tardy Amount</div>
                            <div class="stat-value text-danger">@item.TotalTardyAmount.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="stat-tile">
                            <div class="stat-label">Absent Amount</div>
                            <div class="stat-value text-danger">@item.TotalAbsentAmount.ToString("N2")</div>
                        </div>
                    </div>
                </div>

                <!-- Statutory & Deductions -->
                <h3 class="h6 fw-bold text-uppercase text-muted mb-2">Contributions & Deductions</h3>
                <div class="row g-2 g-md-3 mb-4">
                    <div class="col-6 col-sm-3">
                        <div class="stat-tile">
                            <div class="stat-label">SSS</div>
                            <div class="stat-value">@item.SSSContribution.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="stat-tile">
                            <div class="stat-label">PHIC</div>
                            <div class="stat-value">@item.PHICContribution.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="stat-tile">
                            <div class="stat-label">HDMF</div>
                            <div class="stat-value">@item.HDMFContribution.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="stat-tile">
                            <div class="stat-label">Tax</div>
                            <div class="stat-value">@item.Tax.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-6">
                        <div class="stat-tile">
                            <div class="stat-label">Other Deductions</div>
                            <div class="stat-value">@item.TotalOtherDeduction.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-6">
                        <div class="stat-tile">
                            <div class="stat-label">Total Loan Balances</div>
                            <div class="stat-value">@item.LoanBalances.ToString("N2")</div>
                        </div>
                    </div>
                </div>

                <!-- Breakdown Sections -->
                @if (!string.IsNullOrWhiteSpace(item.OtherDeductionBreakdown) ||
                            !string.IsNullOrWhiteSpace(item.LoanBalancesBreakdown) ||
                            !string.IsNullOrWhiteSpace(item.OtBreakdown) ||
                            !string.IsNullOrWhiteSpace(item.LeaveBalanceBreakdown))
                {
                    <h3 class="h6 fw-bold text-uppercase text-muted mb-2">Breakdowns</h3>
                    <div class="row g-3">
                        @if (!string.IsNullOrWhiteSpace(item.OtherDeductionBreakdown))
                        {
                            <div class="col-12 col-md-6">
                                <div class="small fw-semibold mb-1">Other Deductions</div>
                                <div class="breakdown-box">@Html.Raw(item.OtherDeductionBreakdown)</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.LoanBalancesBreakdown))
                        {
                            <div class="col-12 col-md-6">
                                <div class="small fw-semibold mb-1">Loan Balances</div>
                                <div class="breakdown-box">@Html.Raw(item.LoanBalancesBreakdown)</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.OtBreakdown))
                        {
                            <div class="col-12 col-md-6">
                                <div class="small fw-semibold mb-1">Overtime Breakdown</div>
                                <div class="breakdown-box">@Html.Raw(item.OtBreakdown)</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.LeaveBalanceBreakdown))
                        {
                            <div class="col-12 col-md-6">
                                <div class="small fw-semibold mb-1">Leave Balances</div>
                                <div class="breakdown-box">@Html.Raw(item.LeaveBalanceBreakdown)</div>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(item.Remarks))
                {
                    <div class="mt-4 pt-3 border-top small text-muted">
                        <strong>Remarks:</strong> @item.Remarks
                    </div>
                }
            </div>
        </div>
    }
</div>

<script>
    function submitPayslipForm() {
        const form = document.getElementById('payslipForm');
        const btn = document.getElementById('fetchPayslipBtn');
        if (btn) {
            btn.disabled = true;
            btn.textContent = 'Loading...';
        }
        if (form) {
            form.submit();
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('payslipForm');
        const btn = document.getElementById('fetchPayslipBtn');
        if (form && btn) {
            form.addEventListener('submit', function () {
                btn.disabled = true;
                btn.textContent = 'Loading...';
            });
        }
    });
</script>