@model PayslipMvcClient.Models.PayslipViewModel
@{
    ViewData["Title"] = "Payslip Viewer";
}

<style>
    .payslip-page {
        max-width: 960px;
    }

    .hero-card {
        border: 0;
        border-radius: 1rem;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0f766e 100%);
        color: #fff;
    }

    .lookup-card,
    .payslip-card {
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 1rem;
    }

    .net-pay-banner {
        background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
        border: 1px solid #a7f3d0;
        border-radius: 0.875rem;
    }

    .stat-tile {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        padding: 0.75rem 0.9rem;
        height: 100%;
    }

    .stat-label {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
        margin-bottom: 0.2rem;
    }

    .stat-value {
        font-size: 1rem;
        font-weight: 700;
        color: #0f172a;
        word-break: break-word;
    }

    .breakdown-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        padding: 0.85rem;
        overflow-x: auto;
    }

        .breakdown-box table {
            width: 100% !important;
            border-collapse: collapse;
            margin-bottom: 0;
        }

        .breakdown-box td {
            width: auto !important;
            font-size: 0.85rem !important;
            padding: 0.35rem 0.25rem;
            border-bottom: 1px dashed #e2e8f0;
        }

        .breakdown-box tr:last-child td {
            border-bottom: 0;
        }

    /* Mobile-first touch & spacing polish */
    @@media (max-width: 575.98px) {
        .payslip-page {
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }

        .form-control,
        .btn {
            min-height: 46px;
            font-size: 1rem;
        }

        .stat-value {
            font-size: 0.95rem;
        }

        .net-pay-amount {
            font-size: 1.5rem !important;
        }
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        .payslip-card {
            box-shadow: none !important;
            border: 1px solid #cbd5e1 !important;
        }
    }
</style>

<div class="container payslip-page py-3 py-md-4">
    <!-- Header Banner -->
    <div class="card hero-card shadow-sm mb-3 mb-md-4 no-print">
        <div class="card-body p-3 p-md-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
            <div>
                <span class="badge bg-light text-dark mb-1">WHRIS Mobile</span>
                <h1 class="h4 h3-md mb-1 fw-bold">Payslip Viewer</h1>
                <p class="mb-0 small text-white-50">I-enter ang Payroll ID ug Mobile Code aron makita ang detalye sa sweldo.</p>
            </div>
        </div>
    </div>

    <!-- Search Form -->
    <div class="card lookup-card shadow-sm mb-4 no-print">
        <div class="card-body p-3 p-md-4">
            <form asp-action="Index" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()

                <div class="col-12 col-sm-6 col-md-4">
                    <label asp-for="PayrollId" class="form-label fw-semibold small text-uppercase text-muted"></label>
                    <input asp-for="PayrollId"
                           type="number"
                           inputmode="numeric"
                           class="form-control"
                           placeholder="e.g. 122" />
                </div>

                <div class="col-12 col-sm-6 col-md-5">
                    <label asp-for="Code" class="form-label fw-semibold small text-uppercase text-muted"></label>
                    <input asp-for="Code"
                           type="text"
                           autocapitalize="characters"
                           autocomplete="off"
                           class="form-control"
                           placeholder="e.g. 455619" />
                </div>

                <div class="col-12 col-md-3 d-grid">
                    <button type="submit" class="btn btn-teal btn-primary fw-semibold">
                        Fetch Payslip
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Error / Info Alert -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning rounded-3 shadow-sm d-flex align-items-center gap-2 no-print" role="alert">
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <!-- Payslip Results -->
    @foreach (var item in Model.Records)
    {
        <div class="card payslip-card shadow-sm mb-4">
            <!-- Employee & Payroll Header -->
            <div class="card-header bg-white border-bottom p-3 p-md-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                    <div>
                        <div class="text-muted small fw-medium">@item.Company</div>
                        <h2 class="h5 mb-1 fw-bold text-dark">@item.FullName</h2>
                        <div class="d-flex flex-wrap gap-2 small text-secondary">
                            <span><strong>Payroll #:</strong> @(item.PayrollNumber ?? "N/A")</span>
                            <span>•</span>
                            <span><strong>Date:</strong> @(item.PayrollDate?.ToString("MMM dd, yyyy") ?? "N/A")</span>
                            <span>•</span>
                            <span><strong>Hours:</strong> @item.TotalWorkingHours.ToString("N2") hrs</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 no-print">
                        <span class="badge @(item.IsLocked ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border") px-3 py-2 rounded-pill">
                            @(item.IsLocked ? "Locked / Final" : "Draft")
                        </span>
                        <button type="button" onclick="window.print()" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            Print
                        </button>
                    </div>
                </div>
            </div>

            <div class="card-body p-3 p-md-4">
                <!-- Net Pay Highlight -->
                <div class="net-pay-banner p-3 p-md-4 mb-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                    <div>
                        <div class="small fw-semibold text-success text-uppercase letter-spacing">Net Take-Home Pay</div>
                        <div class="small text-muted">Payroll ID: @item.PayrollId | Employee ID: @item.EmployeeId</div>
                    </div>
                    <div class="net-pay-amount fs-3 fw-bold text-success">
                        @item.NetIncome.ToString("N2")
                    </div>
                </div>

                <!-- Earnings Summary -->
                <h3 class="h6 fw-bold text-uppercase text-muted mb-2">Earnings</h3>
                <div class="row g-2 g-md-3 mb-4">
                    <div class="col-6 col-md-4">
                        <div class="stat-tile">
                            <div class="stat-label">Basic Salary</div>
                            <div class="stat-value">@item.BasicSalary.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="stat-tile">
                            <div class="stat-label">Other Salary / OT</div>
                            <div class="stat-value">@item.OtherSalary.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="stat-tile">
                            <div class="stat-label">Gross Income</div>
                            <div class="stat-value">@item.GrossIncome.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="stat-tile">
                            <div class="stat-label">Non-Taxable Income</div>
                            <div class="stat-value">@item.TotalOtherIncomeNonTaxable.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="stat-tile">
                            <div class="stat-label">Tardy Amount</div>
                            <div class="stat-value text-danger">@item.TotalTardyAmount.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="stat-tile">
                            <div class="stat-label">Absent Amount</div>
                            <div class="stat-value text-danger">@item.TotalAbsentAmount.ToString("N2")</div>
                        </div>
                    </div>
                </div>

                <!-- Statutory & Deductions -->
                <h3 class="h6 fw-bold text-uppercase text-muted mb-2">Contributions & Deductions</h3>
                <div class="row g-2 g-md-3 mb-4">
                    <div class="col-6 col-sm-3">
                        <div class="stat-tile">
                            <div class="stat-label">SSS</div>
                            <div class="stat-value">@item.SSSContribution.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="stat-tile">
                            <div class="stat-label">PHIC</div>
                            <div class="stat-value">@item.PHICContribution.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="stat-tile">
                            <div class="stat-label">HDMF</div>
                            <div class="stat-value">@item.HDMFContribution.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="stat-tile">
                            <div class="stat-label">Tax</div>
                            <div class="stat-value">@item.Tax.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-6">
                        <div class="stat-tile">
                            <div class="stat-label">Other Deductions</div>
                            <div class="stat-value">@item.TotalOtherDeduction.ToString("N2")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-6">
                        <div class="stat-tile">
                            <div class="stat-label">Total Loan Balances</div>
                            <div class="stat-value">@item.LoanBalances.ToString("N2")</div>
                        </div>
                    </div>
                </div>

                <!-- Breakdown Sections -->
                @if (!string.IsNullOrWhiteSpace(item.OtherDeductionBreakdown) ||
                            !string.IsNullOrWhiteSpace(item.LoanBalancesBreakdown) ||
                            !string.IsNullOrWhiteSpace(item.OtBreakdown) ||
                            !string.IsNullOrWhiteSpace(item.LeaveBalanceBreakdown))
                {
                    <h3 class="h6 fw-bold text-uppercase text-muted mb-2">Breakdowns</h3>
                    <div class="row g-3">
                        @if (!string.IsNullOrWhiteSpace(item.OtherDeductionBreakdown))
                        {
                            <div class="col-12 col-md-6">
                                <div class="small fw-semibold mb-1">Other Deductions</div>
                                <div class="breakdown-box">@Html.Raw(item.OtherDeductionBreakdown)</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.LoanBalancesBreakdown))
                        {
                            <div class="col-12 col-md-6">
                                <div class="small fw-semibold mb-1">Loan Balances</div>
                                <div class="breakdown-box">@Html.Raw(item.LoanBalancesBreakdown)</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.OtBreakdown))
                        {
                            <div class="col-12 col-md-6">
                                <div class="small fw-semibold mb-1">Overtime Breakdown</div>
                                <div class="breakdown-box">@Html.Raw(item.OtBreakdown)</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.LeaveBalanceBreakdown))
                        {
                            <div class="col-12 col-md-6">
                                <div class="small fw-semibold mb-1">Leave Balances</div>
                                <div class="breakdown-box">@Html.Raw(item.LeaveBalanceBreakdown)</div>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(item.Remarks))
                {
                    <div class="mt-4 pt-3 border-top small text-muted">
                        <strong>Remarks:</strong> @item.Remarks
                    </div>
                }
            </div>
        </div>
    }
</div>