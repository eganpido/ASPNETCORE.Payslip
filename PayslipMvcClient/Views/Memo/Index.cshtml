@model PayslipMvcClient.Models.MemoViewModel
@{
    ViewData["Title"] = "Memo";
}

<style>
    :root {
        --bg-card: #1c1e21;
        --bg-card-elevated: #23262b;
        --border-dark: rgba(255, 255, 255, 0.08);
        --text-primary: #f3f4f6;
        --text-muted-dark: #9ca3af;
        --accent-emerald: #10b981;
        --accent-emerald-soft: #34d399;
    }

    .memo-shell {
        width: 100%;
        max-width: 680px;
        margin: 0 auto;
        padding: 0.25rem 0.15rem 2rem;
    }

    .memo-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .memo-title {
        font-size: clamp(1.2rem, 4vw, 1.45rem);
        font-weight: 600;
        margin: 0;
        color: var(--text-primary);
    }

    .btn-logoff {
        background-color: var(--bg-card);
        color: #e5e7eb;
        border: 1px solid var(--border-dark);
        border-radius: 999px;
        padding: 0.38rem 0.85rem;
        font-size: 0.76rem;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

        .btn-logoff:hover {
            background-color: var(--bg-card-elevated);
            border-color: rgba(16, 185, 129, 0.35);
            color: #fff;
        }

    .memo-hero-card {
        background: linear-gradient(135deg, #198754 0%, #10b981 55%, #059669 100%);
        border-radius: 1.15rem;
        padding: 1.1rem 1.25rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 12px 28px rgba(16, 185, 129, 0.16);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .memo-hero-label {
        font-size: 0.78rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.9);
    }

    .memo-hero-count {
        font-size: clamp(1.3rem, 5vw, 1.7rem);
        font-weight: 700;
        line-height: 1.15;
        font-variant-numeric: tabular-nums;
    }

    .memo-code-badge {
        background-color: rgba(0, 0, 0, 0.28);
        color: #ecfdf5;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.25rem 0.65rem;
        border-radius: 0.45rem;
        white-space: nowrap;
    }

    .memo-section-heading {
        font-size: 0.74rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted-dark);
        margin: 0 0 0.65rem 0.15rem;
    }

    .memo-list {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
    }

    .memo-card {
        background: linear-gradient(180deg, rgba(35, 38, 43, 0.94) 0%, rgba(28, 30, 33, 0.99) 100%);
        border: 1px solid var(--border-dark);
        border-left: 3px solid var(--accent-emerald);
        border-radius: 1rem;
        padding: 0.95rem 1rem;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
        transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
    }

        .memo-card:hover {
            transform: translateY(-1px);
            border-color: rgba(16, 185, 129, 0.35);
            border-left-color: var(--accent-emerald-soft);
            box-shadow: 0 12px 26px rgba(0, 0, 0, 0.38);
        }

    .memo-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.45rem;
        flex-wrap: wrap;
    }

    .memo-subject {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
        line-height: 1.3;
    }

    .memo-date-pill {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--accent-emerald-soft);
        background-color: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.25);
        padding: 0.14rem 0.55rem;
        border-radius: 999px;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .memo-meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 0.65rem;
        font-size: 0.7rem;
        color: var(--text-muted-dark);
        font-variant-numeric: tabular-nums;
    }

    .memo-meta-chip {
        background-color: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 0.45rem;
        padding: 0.16rem 0.5rem;
    }

    .memo-body {
        font-size: 0.82rem;
        line-height: 1.55;
        color: #e5e7eb;
        white-space: pre-line;
        word-break: break-word;
        padding-top: 0.55rem;
        border-top: 1px dashed rgba(255, 255, 255, 0.08);
    }

    .memo-attachment-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 0.65rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--accent-emerald-soft);
        text-decoration: none;
    }

        .memo-attachment-link:hover {
            text-decoration: underline;
            color: #6ee7b7;
        }

    .memo-alert-warn {
        background-color: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.35);
        color: #fde68a;
        border-radius: 0.85rem;
        padding: 0.8rem 1rem;
        font-size: 0.82rem;
        margin-bottom: 1rem;
    }
</style>

<div class="memo-shell">
    <div class="memo-top-bar">
        <h1 class="memo-title">Memos</h1>
        <a asp-controller="Home" asp-action="Logout" class="btn-logoff">Log-off</a>
    </div>

    <div class="memo-hero-card">
        <div>
            <div class="memo-hero-label">Total Memos</div>
            <div class="memo-hero-count">@Model.Memos.Count</div>
        </div>
        <span class="memo-code-badge">Code: @Model.Code</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="memo-alert-warn" role="alert">
            @Model.ErrorMessage
        </div>
    }

    @if (Model.Memos.Any())
    {
        <div class="memo-section-heading">Announcements &amp; Notices</div>
        <div class="memo-list">
            @foreach (var memo in Model.Memos)
            {
                var subjectText = string.IsNullOrWhiteSpace(memo.MemoSubject) ? $"Memo #{memo.Id}" : memo.MemoSubject;

                <article class="memo-card">
                    <div class="memo-card-header">
                        <h2 class="memo-subject">@subjectText</h2>
                        @if (!string.IsNullOrWhiteSpace(memo.MemoDate))
                        {
                            <span class="memo-date-pill">@memo.MemoDate</span>
                        }
                    </div>

                    <div class="memo-meta-row">
                        <span class="memo-meta-chip">ID: <strong>@memo.Id</strong></span>
                        @if (memo.PreparedBy > 0)
                        {
                            <span class="memo-meta-chip">Prepared By: <strong>@memo.PreparedBy</strong></span>
                        }
                        @if (memo.ApprovedBy > 0)
                        {
                            <span class="memo-meta-chip">Approved By: <strong>@memo.ApprovedBy</strong></span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(memo.MemoContent))
                    {
                        <div class="memo-body">@memo.MemoContent</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(memo.FilePath))
                    {
                        var hrefUrl = memo.FilePath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                        ? memo.FilePath
                        : $"http://streetsmart-001-site1.gtempurl.com//{memo.FilePath.TrimStart('/')}";

                        <a href="@hrefUrl" target="_blank" rel="noopener noreferrer" class="memo-attachment-link">
                            View Attachment (@memo.FilePath) &rarr;
                        </a>
                    }
                </article>
            }
        </div>
    }
</div>